<style is:global>
  header,
  footer {
    display: none !important;
  }
  html,
  body {
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    height: 100vh !important;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("pitch-deck-container");

    if (container) {
      container.focus();

      // 1. TASTATUR NAVIGATION
      window.addEventListener("keydown", (e) => {
        const isNext = e.key === "ArrowDown" || e.key === "PageDown" || (e.key === " " && !e.shiftKey);
        const isPrev = e.key === "ArrowUp" || e.key === "PageUp" || (e.key === " " && e.shiftKey);

        if (isNext) {
          e.preventDefault();
          container.scrollBy({ top: container.clientHeight, behavior: "smooth" });
        } else if (isPrev) {
          e.preventDefault();
          container.scrollBy({ top: -container.clientHeight, behavior: "smooth" });
        }
      });

      // 2. ZOOM & PAN LOGIK
      const images = document.querySelectorAll(".zoomable-img");

      images.forEach((img) => {
        let zoomLevel = 0;
        let isDragging = false;
        let startX = 0,
          startY = 0;
        let currentX = 0,
          currentY = 0;

        const applyTransform = (smooth) => {
          img.style.transition = smooth ? "transform 0.25s ease-out" : "none";

          if (zoomLevel === 0) {
            currentX = 0;
            currentY = 0;
            img.style.transform = "";
            container.style.overflowY = "scroll";
          } else {
            const scale = zoomLevel === 1 ? 1.8 : 2.8;
            img.style.transform = `translate(${currentX}px, ${currentY}px) scale(${scale})`;
            container.style.overflowY = "hidden";
          }
        };

        // DOBBELTKLIK
        img.addEventListener("dblclick", (e) => {
          e.preventDefault();

          if (zoomLevel === 0) {
            zoomLevel = 1;
            const rect = img.getBoundingClientRect();
            // Centrer ud fra klikposition
            currentX = window.innerWidth / 2 - e.clientX;
            currentY = window.innerHeight / 2 - e.clientY;

            img.classList.remove("cursor-zoom-in");
            img.classList.add("cursor-grab");
          } else if (zoomLevel === 1) {
            zoomLevel = 2;
            img.classList.remove("cursor-grab");
            img.classList.add("cursor-zoom-out");
          } else {
            zoomLevel = 0;
            img.classList.remove("cursor-zoom-out", "cursor-grab");
            img.classList.add("cursor-zoom-in");
          }

          applyTransform(true);
        });

        // PAN / DRAG HÅNDTERING
        img.addEventListener("pointerdown", (e) => {
          if (zoomLevel === 0) return;
          e.preventDefault();
          isDragging = true;

          if (img.setPointerCapture) {
            img.setPointerCapture(e.pointerId);
          }

          startX = e.clientX - currentX;
          startY = e.clientY - currentY;

          img.classList.remove("cursor-grab", "cursor-zoom-out");
          img.classList.add("cursor-grabbing");
        });

        img.addEventListener("pointermove", (e) => {
          if (!isDragging || zoomLevel === 0) return;
          e.preventDefault();

          currentX = e.clientX - startX;
          currentY = e.clientY - startY;

          applyTransform(false);
        });

        const stopDrag = (e) => {
          if (isDragging) {
            isDragging = false;
            if (img.releasePointerCapture && e.pointerId) {
              img.releasePointerCapture(e.pointerId);
            }
            img.classList.remove("cursor-grabbing");
            img.classList.add(zoomLevel === 2 ? "cursor-zoom-out" : "cursor-grab");
          }
        };

        img.addEventListener("pointerup", stopDrag);
        img.addEventListener("pointercancel", stopDrag);

        // NULSTIL VED SCROLL
        container.addEventListener("scroll", () => {
          if (zoomLevel !== 0) {
            zoomLevel = 0;
            applyTransform(true);
          }
        });
      });
    }
  });
</script>
