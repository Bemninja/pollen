---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import "../styles/tobii.min.css";
---

<MainLayout title="Pollen of the Sakura - Pitch Deck">
  <div class="fixed top-6 right-6 z-50">
    <a
      href="/onesheet"
      class="group no-underline inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-neutral-900/80 hover:bg-neutral-800 text-neutral-300 hover:text-white backdrop-blur-md border border-neutral-700/60 hover:border-neutral-500 text-xs uppercase tracking-widest font-semibold transition-all duration-300 shadow-2xl hover:shadow-neutral-700/20 active:scale-95"
    >
      <span>One Sheet</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-neutral-400 group-hover:text-white transition-transform duration-300 group-hover:translate-x-1"
      >
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </a>
  </div>

  <div class="fixed bottom-6 right-6 z-50">
    <a
      href="#slide-13"
      class="group no-underline inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-neutral-900/80 hover:bg-neutral-800 text-neutral-300 hover:text-white backdrop-blur-md border border-neutral-700/60 hover:border-neutral-500 text-xs uppercase tracking-widest font-semibold transition-all duration-300 shadow-2xl hover:shadow-neutral-700/20 active:scale-95"
    >
      <span>Contact</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-neutral-400 group-hover:text-white transition-transform duration-300 group-hover:translate-x-0.5"
      >
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
        ></path>
      </svg>
    </a>
  </div>

  <section id="pitch-deck-container" tabindex="0" class="w-screen h-[100dvh] overflow-y-scroll snap-y snap-mandatory
         scroll-smooth overscroll-contain
         px-4 md:px-20 bg-black outline-none block">
    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/1.jpg" alt="pollen 1" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/2.jpg" alt="pollen 2" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/3.jpg" alt="pollen 3" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/4.jpg" alt="pollen 4" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/5.jpg" alt="pollen 5" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/6.jpg" alt="pollen 6" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/7.jpg" alt="pollen 7" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/8.jpg" alt="pollen 8" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/9.jpg" alt="pollen 9" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/10.jpg" alt="pollen 10" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/11.jpg" alt="pollen 11" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/12.jpg" alt="pollen 12" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <div id="slide-13" class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/13.jpg" alt="pollen 13" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>
  </section>
</MainLayout>

<style is:global>
  header,
  footer {
    display: none !important;
  }
  html,
  body {
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    height: 100vh !important;
    height: 100dvh !important;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("pitch-deck-container");

    if (container) {
      container.focus();

      // 1. TASTATUR NAVIGATION
      window.addEventListener("keydown", (e) => {
        const isNext = e.key === "ArrowDown" || e.key === "PageDown" || (e.key === " " && !e.shiftKey);
        const isPrev = e.key === "ArrowUp" || e.key === "PageUp" || (e.key === " " && e.shiftKey);

        if (isNext) {
          e.preventDefault();
          container.scrollBy({ top: container.clientHeight, behavior: "smooth" });
        } else if (isPrev) {
          e.preventDefault();
          container.scrollBy({ top: -container.clientHeight, behavior: "smooth" });
        }
      });

      // 2. UNIVERSEL ZOOM, PINCH OG PAN LOGIK
      const images = document.querySelectorAll(".zoomable-img");

      images.forEach((img) => {
        let currentScale = 1;
        let currentX = 0;
        let currentY = 0;

        let isDragging = false;
        let startX = 0,
          startY = 0;

        let initialPinchDist = 0;
        let initialPinchScale = 1;

        const updateTransform = (smooth = false) => {
          img.style.transition = smooth ? "transform 0.25s ease-out" : "none";

          if (currentScale <= 1.05) {
            currentScale = 1;
            currentX = 0;
            currentY = 0;
            img.style.transform = "";
            img.style.touchAction = "pan-y";
            container.style.overflowY = "scroll";
            img.classList.remove("cursor-grab", "cursor-grabbing", "cursor-zoom-out");
            img.classList.add("cursor-zoom-in");
          } else {
            img.style.transform = `translate(${currentX}px, ${currentY}px) scale(${currentScale})`;
            img.style.touchAction = "none";
            container.style.overflowY = "hidden";
            img.classList.remove("cursor-zoom-in");
            img.classList.add(isDragging ? "cursor-grabbing" : "cursor-grab");
          }
        };

        // DOBBELTKLIK / DOBBELT-TAP
        img.addEventListener("dblclick", (e) => {
          e.preventDefault();

          if (currentScale === 1) {
            currentScale = 1.8;
            currentX = window.innerWidth / 2 - e.clientX;
            currentY = window.innerHeight / 2 - e.clientY;
          } else if (currentScale < 2.5) {
            currentScale = 2.8;
          } else {
            currentScale = 1;
          }

          updateTransform(true);
        });

        // MUS OG SINGLE TOUCH PANNING
        img.addEventListener("pointerdown", (e) => {
          if (currentScale <= 1) return;
          isDragging = true;

          if (img.setPointerCapture) {
            try {
              img.setPointerCapture(e.pointerId);
            } catch (_) {}
          }

          startX = e.clientX - currentX;
          startY = e.clientY - currentY;
          updateTransform(false);
        });

        img.addEventListener("pointermove", (e) => {
          if (!isDragging || currentScale <= 1) return;
          e.preventDefault();

          currentX = e.clientX - startX;
          currentY = e.clientY - startY;

          updateTransform(false);
        });

        const stopDrag = (e) => {
          if (isDragging) {
            isDragging = false;
            if (img.releasePointerCapture && e.pointerId) {
              try {
                img.releasePointerCapture(e.pointerId);
              } catch (_) {}
            }
            updateTransform(false);
          }
        };

        img.addEventListener("pointerup", stopDrag);
        img.addEventListener("pointercancel", stopDrag);

        // TWO-FINGER PINCH-TO-ZOOM (TOUCH)
        img.addEventListener(
          "touchstart",
          (e) => {
            if (e.touches.length === 2) {
              initialPinchDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
              initialPinchScale = currentScale;
            }
          },
          { passive: true },
        );

        img.addEventListener(
          "touchmove",
          (e) => {
            if (e.touches.length === 2 && initialPinchDist > 0) {
              e.preventDefault();
              const currentDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
              const scaleFactor = currentDist / initialPinchDist;
              currentScale = Math.min(Math.max(initialPinchScale * scaleFactor, 1), 4);
              updateTransform(false);
            }
          },
          { passive: false },
        );

        img.addEventListener("touchend", (e) => {
          if (e.touches.length < 2) {
            initialPinchDist = 0;
            if (currentScale < 1.1) {
              currentScale = 1;
              updateTransform(true);
            }
          }
        });

        // NULSTIL HVIS DER SCROLLES TIL NÆSTE SLIDE
        container.addEventListener("scroll", () => {
          if (currentScale !== 1) {
            currentScale = 1;
            updateTransform(true);
          }
        });
      });
    }
  });
</script>
