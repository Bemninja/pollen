---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import "../styles/tobii.min.css";
---

<MainLayout title="Pollen of the Sakura - Pitch Deck">
  <!-- Knap i øverste højre hjørne til One Sheet -->
  <div class="fixed top-6 right-6 z-50">
    <a
      href="/onesheet"
      class="group no-underline inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-neutral-900/80 hover:bg-neutral-800 text-neutral-300 hover:text-white backdrop-blur-md border border-neutral-700/60 hover:border-neutral-500 text-xs uppercase tracking-widest font-semibold transition-all duration-300 shadow-2xl hover:shadow-neutral-700/20 active:scale-95"
    >
      <span>One Sheet</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-neutral-400 group-hover:text-white transition-transform duration-300 group-hover:translate-x-1"
      >
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </a>
  </div>

  <!-- Dynamic Contact/Top button -->
  <div class="fixed bottom-6 right-6 z-50">
    <a
      id="contact-top-btn"
      href="#slide-13"
      class="group no-underline inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-neutral-900/80 hover:bg-neutral-800 text-neutral-300 hover:text-white backdrop-blur-md border border-neutral-700/60 hover:border-neutral-500 text-xs uppercase tracking-widest font-semibold transition-all duration-300 shadow-2xl hover:shadow-neutral-700/20 active:scale-95"
    >
      <span id="btn-text">Contact</span>
      <svg
        id="btn-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-neutral-400 group-hover:text-white transition-transform duration-300 group-hover:translate-x-0.5"
      >
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
        ></path>
      </svg>
    </a>
  </div>

  <section id="pitch-deck-container" tabindex="0" class="w-screen h-[100dvh] overflow-y-scroll snap-y snap-mandatory
         scroll-smooth overscroll-contain
         px-4 md:px-20 bg-black outline-none block">
    <!-- Slide 1 -->
    <div id="slide-1" class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/1.jpg" alt="pollen 1" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <!-- Slide 2 -->
    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/2.jpg" alt="pollen 2" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <!-- Slide 3 -->
    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/3.jpg" alt="pollen 3" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <!-- Slide 4 -->
    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/4.jpg" alt="pollen 4" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <!-- Slide 5 -->
    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/5.jpg" alt="pollen 5" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <!-- Slide 6 -->
    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/6.jpg" alt="pollen 6" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <!-- Slide 7 -->
    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/7.jpg" alt="pollen 7" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <!-- Slide 8 -->
    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/8.jpg" alt="pollen 8" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <!-- Slide 9 -->
    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/9.jpg" alt="pollen 9" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <!-- Slide 10 -->
    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/10.jpg" alt="pollen 10" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <!-- Slide 11 -->
    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/11.jpg" alt="pollen 11" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <!-- Slide 12 -->
    <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/12.jpg" alt="pollen 12" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>

    <!-- Slide 13 -->
    <div id="slide-13" class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
      <img src="../assets/images/13.jpg" alt="pollen 13" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
    </div>
  </section>
</MainLayout>

<style is:global>
  header,
  footer {
    display: none !important;
  }
  html,
  body {
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    height: 100vh !important;
    height: 100dvh !important;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("pitch-deck-container");
    const slide13 = document.getElementById("slide-13");
    const btn = document.getElementById("contact-top-btn");
    const btnText = document.getElementById("btn-text");
    const btnIcon = document.getElementById("btn-icon");

    if (slide13 && btn && btnText && btnIcon && container) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              btn.setAttribute("href", "#slide-1");
              btnText.textContent = "Top";
              btnIcon.innerHTML = `<path d="m18 15-6-6-6 6"/>`;
            } else {
              btn.setAttribute("href", "#slide-13");
              btnText.textContent = "Contact";
              btnIcon.innerHTML = `<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>`;
            }
          });
        },
        { root: container, threshold: 0.6 },
      );
      observer.observe(slide13);
    }

    if (container) {
      container.focus();

      window.addEventListener("keydown", (e) => {
        const isNext = e.key === "ArrowDown" || e.key === "PageDown" || (e.key === " " && !e.shiftKey);
        const isPrev = e.key === "ArrowUp" || e.key === "PageUp" || (e.key === " " && e.shiftKey);

        if (isNext) {
          e.preventDefault();
          container.scrollBy({ top: container.clientHeight, behavior: "smooth" });
        } else if (isPrev) {
          e.preventDefault();
          container.scrollBy({ top: -container.clientHeight, behavior: "smooth" });
        }
      });

      const images = document.querySelectorAll(".zoomable-img");

      images.forEach((img) => {
        img.ondragstart = () => false;

        let currentScale = 1;
        let currentX = 0;
        let currentY = 0;

        let isDragging = false;
        let startX = 0,
          startY = 0;

        let initialPinchDist = 0;
        let initialPinchScale = 1;

        const updateTransform = (smooth = false) => {
          img.style.transition = smooth ? "transform 0.25s ease-out" : "none";

          if (currentScale <= 1.05) {
            currentScale = 1;
            currentX = 0;
            currentY = 0;
            img.style.transform = "";
            img.style.touchAction = "pan-y";
            container.style.overflowY = "scroll";
            img.classList.remove("cursor-grab", "cursor-grabbing", "cursor-zoom-out");
            img.classList.add("cursor-zoom-in");
          } else {
            img.style.transform = `translate(${currentX}px, ${currentY}px) scale(${currentScale})`;
            img.style.touchAction = "none";
            container.style.overflowY = "hidden";
            img.classList.remove("cursor-zoom-in");
            img.classList.add(isDragging ? "cursor-grabbing" : "cursor-grab");
          }
        };

        img.addEventListener("dblclick", (e) => {
          e.preventDefault();

          let targetScale = 1;
          if (currentScale === 1) {
            targetScale = 1.8;
          } else if (currentScale < 2.5) {
            targetScale = 2.8;
          } else {
            targetScale = 1;
          }

          if (targetScale === 1) {
            currentScale = 1;
            currentX = 0;
            currentY = 0;
          } else {
            const rect = img.getBoundingClientRect();
            // Trækker den nuværende forskydning fra, så vi måler ud fra billedets uskalerede midte
            const centerX = rect.left + rect.width / 2 - currentX;
            const centerY = rect.top + rect.height / 2 - currentY;

            const offsetX = (e.clientX - centerX) / currentScale;
            const offsetY = (e.clientY - centerY) / currentScale;

            currentX = e.clientX - centerX - offsetX * targetScale;
            currentY = e.clientY - centerY - offsetY * targetScale;
            currentScale = targetScale;
          }

          updateTransform(true);
        });

        img.addEventListener("pointerdown", (e) => {
          if (currentScale <= 1) return;
          e.preventDefault();

          isDragging = true;
          startX = e.clientX - currentX;
          startY = e.clientY - currentY;

          if (img.setPointerCapture) {
            try {
              img.setPointerCapture(e.pointerId);
            } catch (_) {}
          }

          updateTransform(false);
        });

        img.addEventListener("pointermove", (e) => {
          if (!isDragging || currentScale <= 1) return;
          e.preventDefault();

          currentX = e.clientX - startX;
          currentY = e.clientY - startY;

          updateTransform(false);
        });

        const stopDrag = (e) => {
          if (isDragging) {
            isDragging = false;
            if (img.hasPointerCapture && img.hasPointerCapture(e.pointerId)) {
              try {
                img.releasePointerCapture(e.pointerId);
              } catch (_) {}
            }
            updateTransform(false);
          }
        };

        img.addEventListener("pointerup", stopDrag);
        img.addEventListener("pointercancel", stopDrag);

        img.addEventListener(
          "touchstart",
          (e) => {
            if (e.touches.length === 2) {
              initialPinchDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
              initialPinchScale = currentScale;
            }
          },
          { passive: true },
        );

        img.addEventListener(
          "touchmove",
          (e) => {
            if (e.touches.length === 2 && initialPinchDist > 0) {
              e.preventDefault();
              const currentDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
              const scaleFactor = currentDist / initialPinchDist;
              currentScale = Math.min(Math.max(initialPinchScale * scaleFactor, 1), 4);
              updateTransform(false);
            }
          },
          { passive: false },
        );

        img.addEventListener("touchend", (e) => {
          if (e.touches.length < 2) {
            initialPinchDist = 0;
            if (currentScale < 1.1) {
              currentScale = 1;
              updateTransform(true);
            }
          }
        });

        container.addEventListener("scroll", () => {
          if (currentScale !== 1) {
            currentScale = 1;
            updateTransform(true);
          }
        });
      });
    }
  });
</script>
